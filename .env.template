# RAGWatch environment variables template
# Copy this file to .env for local development:
#   cp .env.template .env
#
# These are LOCAL DEVELOPMENT credentials only.
# Do NOT use these in production.

# Local PostgreSQL + pgvector database URL
# Port 5433 is used to avoid conflicts with any existing Postgres on 5432.
RAGWATCH_PGVECTOR_URL=postgresql://ragwatch:ragwatch@localhost:5433/ragwatch

# ---------------------------------------------------------------------------
# Optional: OpenTelemetry + Grafana observability backend
# ---------------------------------------------------------------------------
# The observability stack (OTel Collector, Prometheus, Tempo, Grafana) lives in
# the root docker-compose.yml under the "observability" profile:
#   docker compose --profile observability up -d
#
# Enable OTLP export from RAGWatch experiments.
RAGWATCH_OTEL_ENABLED=false
#
# Exporter type: otlp (send to the collector) or console (local debugging).
RAGWATCH_OTEL_EXPORTER=otlp
#
# OTLP gRPC endpoint of the collector.
RAGWATCH_OTEL_ENDPOINT=http://localhost:4317
#
# Service name attached to emitted traces.
RAGWATCH_OTEL_SERVICE_NAME=ragwatch

# ---------------------------------------------------------------------------
# Optional: dataset selection for the dataset-agnostic experiment scripts
# ---------------------------------------------------------------------------
# The generic scripts (run_retriever_comparison.py and run_drift_experiment.py)
# choose their dataset from the registry via RAGWATCH_DATASET. Supported names:
#   squad      SQuAD v1.1 reading-comprehension QA
#   hotpotqa   HotpotQA multi-hop QA
#
# Dataset name from the registry (default: squad).
RAGWATCH_DATASET=squad
#
# Split to load (default: the registry entry's default, e.g. validation).
RAGWATCH_DATASET_SPLIT=validation
#
# Number of QA examples to actually run per experiment.
RAGWATCH_DATASET_MAX_EXAMPLES=120
#
# Number of rows to load when building the corpus (drift uses a larger slice so
# corpus-level perturbations are non-degenerate).
RAGWATCH_DATASET_LOAD_MAX_EXAMPLES=200

# ---------------------------------------------------------------------------
# Optional: semantic (embedding-based) KPI metrics
# ---------------------------------------------------------------------------
# Semantic KPIs require: pip install -e ".[semantic]"
#
# Semantic KPIs are computed BY DEFAULT in the main research experiment scripts
# (run_retriever_comparison.py and run_drift_experiment.py) using the local
# sentence-transformers provider (no API key needed).
#
# Set this opt-out flag to true to run those scripts deterministic-only,
# without semantic KPIs or semantic dependencies.
RAGWATCH_DISABLE_SEMANTIC_KPIS=false
#
# Semantic KPI provider (default: local).
# Options: local, openai, azure_openai
RAGWATCH_SEMANTIC_PROVIDER=local

# Local sentence-transformers model.
RAGWATCH_LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Direct OpenAI embeddings (RAGWATCH_OPENAI_EMBEDDING_MODEL is a model name).
RAGWATCH_OPENAI_API_KEY=
RAGWATCH_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Azure OpenAI embeddings (the deployment is a DEPLOYMENT name, not a model name).
RAGWATCH_AZURE_OPENAI_API_KEY=
RAGWATCH_AZURE_OPENAI_ENDPOINT=
RAGWATCH_AZURE_OPENAI_API_VERSION=2024-02-01
RAGWATCH_AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# ---------------------------------------------------------------------------
# Optional: comparison and figure output directories
# ---------------------------------------------------------------------------
# By default, the retriever comparison example writes to a dataset-/mode-specific
# directory so datasets, semantic, and opt-out runs do not overwrite each other:
#   outputs/comparisons/squad_retrievers_semantic_local/      (default)
#   outputs/comparisons/hotpotqa_retrievers_semantic_local/
#   outputs/comparisons/squad_retrievers_semantic_openai/     (etc.)
#   outputs/comparisons/squad_retrievers_base/                (opt-out)
#
# Set this to use a custom comparison output directory verbatim instead.
RAGWATCH_COMPARISON_OUTPUT_DIR=
#
# By default, the plot example writes figures to outputs/figures/<comparison
# directory name>. Set this to use a custom figures directory verbatim instead.
RAGWATCH_FIGURE_OUTPUT_DIR=

# ---------------------------------------------------------------------------
# Optional: rule-based drift experiment output directory
# ---------------------------------------------------------------------------
# By default, the drift experiment example writes to a dataset-/mode-specific
# directory:
#   outputs/drift/squad_tfidf_semantic_local/      (default)
#   outputs/drift/hotpotqa_tfidf_semantic_local/
#   outputs/drift/squad_tfidf_semantic_openai/     (etc.)
#   outputs/drift/squad_tfidf_base/                (opt-out)
# Set this to use a custom drift output directory verbatim instead.
RAGWATCH_DRIFT_OUTPUT_DIR=
#
# By default, the drift plot example writes figures to <drift dir>/figures/.
# Set this to use a custom drift figures directory verbatim instead.
RAGWATCH_DRIFT_FIGURE_OUTPUT_DIR=

# Copy this file to `.env` and fill in the required secrets.
OPENAI_API_KEY=your-openai-api-key-here

# Base directory for all RAGWatch logs (absolute or relative)
RAGWATCH_LOG_DIR=logs

# HotpotQA-specific log directory (defaults to logs/hotpotqa)
RAGWATCH_HOTPOTQA_LOG_DIR=logs/hotpotqa

# Directory where the FAISS index for HotpotQA is stored
RAGWATCH_HOTPOTQA_INDEX_DIR=data/indexes/hotpotqa

# HotpotQA dataset configuration
RAGWATCH_HOTPOTQA_SPLIT=validation
RAGWATCH_HOTPOTQA_SAMPLE_SIZE=25

# Set to "true" to use the lightweight dummy data instead of downloading HotpotQA
RAGWATCH_HOTPOTQA_USE_DUMMY_DATA=false

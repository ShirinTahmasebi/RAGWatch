{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "HotpotQA Stream (debug)",
            "type": "debugpy",
            "request": "launch",
            "module": "ragwatch_client",
            "justMyCode": true,
            "args": [
                "stream",
                "hotpotqa",
                "--interval",
                "1.0",
                "--max-iterations",
                "10"
            ],
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        }
    ]
}
